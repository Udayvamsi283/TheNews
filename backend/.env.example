# ===================================================
# THE NEWS REPORT — BACKEND ENVIRONMENT VARIABLES
# ===================================================

# Server Environment & Port (On Render, PORT is dynamically allocated if omitted)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/the_news?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/the_news?retryWrites=true&w=majority

# Client URLs (Comma-separated for multiple origins, e.g. dev and production frontend)
# Used for CORS whitelist and SameSite cross-domain cookie credentials
CLIENT_URL=https://<your-vercel-domain>.vercel.app,http://localhost:5173

# Authentication & Cryptographic Secrets (minimum 32 characters recommended)
JWT_SECRET=replace-with-a-secure-random-jwt-secret-minimum-32-chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-a-secure-random-cookie-secret-minimum-32-chars

# Administrator Credentials (Used for initial admin authentication)
ADMIN_EMAIL=admin@thenews.org
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Cloudinary Storage Credentials (Used for image/media uploads and transformations)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
