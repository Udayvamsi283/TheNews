# ===================================================
# THE NEWS REPORT — FRONTEND ENVIRONMENT VARIABLES
# ===================================================

# In local development:
# Points to your local backend server:
VITE_API_BASE_URL=http://localhost:5000/api/v1

# In production (e.g. on Vercel):
# Set this to your deployed Render backend URL:
# VITE_API_BASE_URL=https://<your-render-service-name>.onrender.com/api/v1

# Optional: Production site URL for absolute OpenGraph / Twitter metadata:
# VITE_SITE_URL=https://<your-vercel-domain>.vercel.app
